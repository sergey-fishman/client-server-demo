      "item": [
        {
          "name": "200 Get contacts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nconst response = pm.response.json();\r\npm.test(\"Response contains 'contacts' array\", function () {\r\n    pm.expect(response).to.have.property('contacts');\r\n});\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(response.contacts).to.be.an('array');\r\n});\r\npm.test(\"Response content-type is application/json\", function () {\r\n    pm.response.to.have.header('Content-Type', 'application/json');\r\n    });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/contacts.php",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "contacts.php"
              ]
            }
          },
          "response": []
        },
